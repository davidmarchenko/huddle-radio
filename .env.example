PORT=8787
PUBLIC_APP_URL=http://localhost:5173

# demo | sleeper | espn
FANTASY_PROVIDER=demo
# demo | espn
SPORTS_DATA_PROVIDER=demo
NEWS_PROVIDER=auto
MODEL_PROVIDER=openai-vision
MODEL_PRESET=sota
COMMENTARY_PROVIDER=auto
TTS_PROVIDER=auto

# OpenAI commentary generation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_FAST_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=none
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_FAST_MODEL=gpt-realtime-mini

# Optional commentary fallback chain. When ANTHROPIC_API_KEY or
# GOOGLE_API_KEY is present, the server wraps OpenAI in a chain that
# tries each vendor in order and falls back to the local templates if
# they all fail. With neither key set, behavior is unchanged.
ANTHROPIC_API_KEY=
ANTHROPIC_COMMENTARY_MODEL=claude-sonnet-4-6
GOOGLE_API_KEY=
GEMINI_COMMENTARY_MODEL=gemini-1.5-pro
COMMENTARY_PROVIDER_TIMEOUT_MS=8000

# Future real video observation backends.
NEMOTRON_MODEL=nvidia/nemotron-3-nano-omni
NEMOTRON_ENDPOINT=
NEMOTRON_API_KEY=

# Sleeper is read-only and does not require an API key.
SLEEPER_LEAGUE_ID=
SLEEPER_WEEK=

# ESPN Fantasy is unofficial. Public leagues may only need league ID.
# Private leagues require ESPN cookies from your own account.
ESPN_LEAGUE_ID=
ESPN_SEASON=
ESPN_SWID=
ESPN_S2=

# ElevenLabs streaming TTS.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2
# Optional per-host voice overrides. When set, Maya / Theo / Cam each
# route to their own ElevenLabs voice id instead of all sharing the
# default above. Any host without an override falls back to ELEVENLABS_VOICE_ID.
ELEVENLABS_VOICE_ID_MAYA=
ELEVENLABS_VOICE_ID_THEO=
ELEVENLABS_VOICE_ID_CAM=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_EXPRESSIVE_MODEL_ID=eleven_v3

# Future provider credentials.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
SPORTRADAR_API_KEY=
SPORTSDATAIO_API_KEY=
FAL_KEY=

# The Odds API (free tier 500 req/mo). When set, the pregame card surfaces
# spread/total/moneyline and the commentary payload includes the line so
# persona prompts can cite it.
THE_ODDS_API_KEY=
